# --- Database: Supabase Postgres (via Prisma) --------------------------------
# From your Supabase project: Settings -> Database -> Connection string.
# Use the "Transaction" pooler (port 6543, pgbouncer=true) for DATABASE_URL -
# this is what the running app uses for every request, and it must go through
# the pooler on serverless platforms like Vercel or you'll exhaust Postgres'
# connection limit. Use the "Session"/direct connection (port 5432) for
# DIRECT_URL - Prisma Migrate needs a non-pooled connection to run migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Storage: Supabase Storage (server-only) ---------------------------------
# Project URL and service role key from Supabase: Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security - it is used only in
# server actions to upload logo/gallery/poster/service images, and must NEVER
# be exposed to the browser (no NEXT_PUBLIC_ prefix) or committed to git.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket used for all uploaded media (logo, gallery, event posters,
# service images). Create it once in Supabase Storage - see README for the
# exact policy needed.
SUPABASE_STORAGE_BUCKET="selecta-media"

# --- Session signing secret - generate a long random string for production --
AUTH_SECRET="change-this-to-a-long-random-string"

# --- Default admin login (used only by the seed script on first run) --------
# Change the password from Admin > Settings > Security as soon as you log in.
ADMIN_EMAIL="dj@selectaevent.com"
ADMIN_PASSWORD="ChangeMe123!"

# --- Public site URL ----------------------------------------------------------
# Used to build contract links and other public links in emails. Set this to
# the real production domain when deploying.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Resend (https://resend.com) ---------------------------------------------
# All application email (quotes, contracts, reminders, receipts, RSVP
# confirmations, etc.) sends through this. Leave RESEND_API_KEY blank to run
# without sending real email - every attempt is still logged in
# Admin > Emails so nothing is lost.
RESEND_API_KEY=""

# The mailbox Resend sends FROM. This address's domain must be verified in
# your Resend dashboard (SPF/DKIM/DMARC DNS records on selectaevent.com).
# The display name in front of it (e.g. "Selecta Event") is controlled from
# Admin > Settings > Email Sending, not here.
RESEND_FROM_EMAIL="no-reply@selectaevent.com"
